[Unit]
Description=실가 backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=silga
WorkingDirectory=/opt/silga/backend
Environment="PATH=/opt/silga/backend/.venv/bin"
ExecStart=/opt/silga/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
